# ── کافینو API — نمونهٔ تنظیمات. فایل را به .env کپی و مقدارها را عوض کنید (هرگز .env را در مخزن نگذارید) ──
NODE_ENV=production
PORT=8080

# پایگاه‌داده (با docker-compose خودکار ساخته می‌شود؛ رمز را حتماً عوض کنید)
POSTGRES_PASSWORD=change-me-to-a-long-random-password
# رمز نقش محدود API (cafino_app). دست‌کم ۱۶ نویسه و متفاوت از POSTGRES_PASSWORD.  تولید: openssl rand -hex 24
APP_DB_PASSWORD=
# نشانی/پورت انتشار nginx روی میزبان (پیش‌فرض فقط loopback؛ TLS را پراکسی جلویی انجام می‌دهد)
WEB_BIND=127.0.0.1
WEB_PORT=8080
DATABASE_URL=postgres://cafino:${POSTGRES_PASSWORD}@db:5432/cafino
# TLS پایگاه‌داده:
#   false  → بدون TLS. فقط وقتی درست است که PostgreSQL داخل شبکهٔ خصوصی docker (همین docker-compose) باشد و بیرون منتشر نشود.
#   true   → TLS با تأیید گواهی و نام میزبان (rejectUnauthorized=true). برای پایگاه‌دادهٔ ابری/جدا: DB_SSL=true
# اگر گواهی سرور با CA خصوصی/خودامضاست، فایل CA را بدهید (مسیر داخل کانتینر)؛ بدون آن، CA های عمومی سیستم استفاده می‌شود.
# (حالت no-verify فقط برای آزمایش است و در تولید بدون DB_SSL_ALLOW_INSECURE=true رد می‌شود.)
# توجه: sslmode را داخل DATABASE_URL نگذارید؛ فقط با DB_SSL تنظیم کنید.
DB_SSL_CA_FILE=

# راز امضای توکن: دست‌کم ۳۲ نویسه تصادفی.  تولید:  openssl rand -hex 48
JWT_SECRET=

# اگر برنامه و API روی یک دامنه‌اند (پیشنهاد می‌شود، با nginx داخل همین بسته) چیزی لازم نیست.
# اگر دامنه‌ها جدا هستند، مبدأ برنامه را اینجا بنویسید (با ویرگول جدا کنید)، مثلاً https://app.example.com
# میزبان‌های مجاز فید «اخبار کافی‌نت» (ویجت داشبورد؛ با ویرگول). پیش‌فرض: onlinecofe.ir,www.onlinecofe.ir
NEWS_FEED_HOSTS=
# پروفایل مجوزهای پیش‌فرض: strict (پیش‌فرضِ Production؛ بخشودگی، برگشت پرداخت و مانده اولیه فقط مدیر/مالک) | compat (رفتار پیش از 1.75)
# هر کافی‌نت می‌تواند مجوزها را در پنل/‏PUT /api/permissions تغییر دهد. خالی بگذارید تا پروفایل خودکار انتخاب شود.
PERMISSION_PROFILE=
# (اختیاری) فقط برای برگشت پرداخت: staff | manager — اگر خالی باشد پروفایل بالا تعیین می‌کند (Production: manager)
PAYMENT_VOID_MIN_ROLE=

# حافظهٔ نهان گزارش‌ها (ms). ابطال در هر نوشتنِ همان کافی‌نت؛ اگر چند نمونهٔ API پشت load-balancer دارید، نمونه‌های دیگر حداکثر تا این مدت کهنه‌اند. 0 = خاموش
REPORT_CACHE_TTL_MS=15000
# (اختیاری، توصیهٔ Production) مهاجرت‌ها با نقش «مالک جدول‌ها» و برنامه با نقش محدود (cafino_app) اجرا شود — deploy/db-roles.sql
MIGRATION_DATABASE_URL=
APP_DB_ROLE=
CORS_ORIGINS=
# چند پراکسی «مورد اعتماد» بین کاربر و API هست؟ (برای محدودکنندهٔ نرخ، قفل ورود و لاگ حسابرسی)
#   1 (پیش‌فرض تولید) = فقط nginx همین بسته. nginx هر X-Forwarded-For کاربر را دور می‌ریزد و IP اتصال را می‌نویسد.
#   false = پراکسی ندارید (API مستقیم به اینترنت وصل است).   یا فهرست آدرس‌ها: 172.16.0.0/12,10.0.0.0/8
#   هرگز «اعتماد به همه» نیست؛ اگر جلوی nginx هم Caddy/ابر دارید: آدرسش را در deploy/trusted-proxies.conf بنویسید.
TRUST_PROXY=1
COOKIE_SECURE=true
# ثبت‌نام عمومی؛ در تولید بسته نگه دارید و کافی‌نت‌ها را از پنل مرکزی بسازید
ALLOW_REGISTRATION=false
# کپچای عددی ورود: بعد از این تعداد شکست (برای همان IP یا همان ایمیل) نمایش داده می‌شود؛ 0 = خاموش (پیش‌فرض 3، پنجره 15 دقیقه)
# CAPTCHA_AFTER_FAILS=3
# CAPTCHA_WINDOW_MIN=15

# ایمیل بازیابی رمز (بدون آن، کد فقط در لاگ سرور نوشته می‌شود — برای تولید مناسب نیست)
SMTP_URL=
MAIL_FROM=کافینو <no-reply@example.com>

# نشست آفلاین (ثانیه): پس از قطع اینترنت، برنامه تا این مدت با هویت ذخیره‌شده کار می‌کند؛ بعد از آن ورود دوباره (آنلاین) لازم است.
OFFLINE_SESSION_MAX_AGE_OWNER_SEC=86400      # مدیر/مالک: ۲۴ ساعت
OFFLINE_SESSION_MAX_AGE_STAFF_SEC=28800      # کارمند: ۸ ساعت

LOG_LEVEL=info

# سقف زمان‌ها در سمت PostgreSQL (ms): هر پرس‌وجو / انتظار برای قفل (0 = نامحدود) / تراکنش باز و بیکار
DB_STATEMENT_TIMEOUT_MS=15000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_TX_TIMEOUT_MS=60000

# ── دریافت فایل از مشتری با QR (اختیاری) ──
# UPLOAD_DIR=/data/uploads            # در Docker یک volume است
# UPLOAD_CAFE_QUOTA_MB=2048           # سقف کل فایل‌های نگه‌داری‌شدهٔ هر کافی‌نت
# UPLOAD_DAILY_FILES_PER_CAFE=300     # سقف فایل دریافتی در ۲۴ ساعت برای هر کافی‌نت
# UPLOAD_IP_PER_HOUR=30               # سقف درخواست آپلود از هر IP در ساعت
# PUBLIC_BASE_URL=https://cafino.example.com   # نشانی عمومی سایت؛ برای ساخت نشانی کامل QR (خالی = از مبدأ مرورگر)
# ── ضدویروس فایل‌های دریافتی (ClamAV) ──
# CLAMAV_HOST=clamav                  # نام سرویس clamav در docker-compose (docker compose --profile av up -d) یا نشانی clamd
# CLAMAV_PORT=3310                    # CLAMAV_SOCKET=/run/clamav/clamd.sock هم ممکن است
# UPLOAD_AV_MODE=required             # off | optional (clamd قطع بود بدون اسکن می‌پذیرد) | required (قطع بود رد می‌کند؛ پیش‌فرض وقتی CLAMAV_HOST هست)
# CLAMAV_TIMEOUT_MS=90000
# ── ربات گزارش بله و تلگرام (1.79) ──
# BOTS_ENABLED=true                   # false = زمان‌بند ربات (گزارش روزانه و پاسخ به فرمان‌ها) خاموش
# BOT_POLL_INTERVAL_MS=6000           # فاصلهٔ دریافت پیام‌های ربات‌ها (هر ربات پیوندخورده/منتظر پیوند)
# BOT_TZ=Asia/Tehran                  # منطقهٔ زمانی «امروز» و ساعت گزارش روزانه
# BOT_TOKEN_KEY=                      # کلید رمزنگاری توکن ربات‌ها (openssl rand -hex 32)؛ خالی = مشتق از JWT_SECRET (با عوض‌شدن JWT_SECRET باید ربات‌ها دوباره متصل شوند)
# BALE_API_BASE=https://tapi.bale.ai
# TELEGRAM_API_BASE=https://api.telegram.org   # تلگرام در ایران فیلتر است: اگر سرور داخل ایران است نشانی یک پراکسی معکوس (مثلاً Cloudflare Worker) بگذارید
# ── مینی‌اپ تلگرام مشتریان (1.80) — یک ربات مشترک برای همهٔ کافی‌نت‌ها ──
# MINIAPP_BOT_TOKEN=                  # توکن ربات مشترک (BotFather). فقط همین‌جا؛ هرگز در مخزن/چت. خالی = مینی‌اپ خاموش
# MINIAPP_URL=https://cafino.example.ir/m   # نشانی HTTPS مینی‌اپ؛ خالی = PUBLIC_BASE_URL + /m
# MINIAPP_AUTH_MAX_AGE_SEC=86400      # حداکثر عمر initData تلگرام
# MINIAPP_SESSION_TTL_SEC=3600        # عمر نشست مینی‌اپ
# MINIAPP_AUTH_RATE_PER_MIN=30        # محدودیت نرخ ورود
# MINIAPP_POLL_INTERVAL_MS=3000       # فاصلهٔ دریافت پیام‌های ربات مشترک
