{
  "name": "cafino-server",
  "version": "1.76.0",
  "private": true,
  "type": "module",
  "description": "API و پایگاه‌داده کافینو (Fastify + PostgreSQL)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "migrate": "node scripts/migrate.mjs",
